# ==========================================
# CVPINTAR SAAS ENVIRONMENT VARIABLES TEMPLATE
# ==========================================
# Salin file ini menjadi .env.local untuk environment lokal / Vercel.
# JANGAN PERNAH commit .env.local atau kredensial rahasia ke Git repository publik!

# ------------------------------------------
# App URL Configuration
# ------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------
# Multi-Provider AI Configuration (Server-side only)
# Automatic Failover: Gemini -> DeepSeek -> Groq -> Local Fallback
# ------------------------------------------
# 1. Gemini (Primary) - Mendukung multi-key dipisah koma: key1,key2,key3
AI_PROVIDER=gemini
AI_API_KEY=your-gemini-api-key-here
AI_MODEL_NAME=gemini-2.0-flash

# 2. DeepSeek (Fallback 1)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL_NAME=deepseek-chat

# 3. Groq (Fallback 2)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# ------------------------------------------
# DOKU Payment Gateway (Server-side only)
# ------------------------------------------
# Environment: sandbox | production
NEXT_PUBLIC_DOKU_ENVIRONMENT=production
DOKU_ENVIRONMENT=production
DOKU_CLIENT_ID=your-doku-client-id-here
DOKU_SECRET_KEY=your-doku-secret-key-here
DOKU_NOTIFICATION_URL=https://yourdomain.com/api/webhooks/doku

# ------------------------------------------
# Admin Access Configuration
# ------------------------------------------
# Email administrator resmi CVPintar (pisahkan dengan koma jika lebih dari satu)
ADMIN_EMAILS=iqbal@cvpintar.id,admin@cvpintar.id
